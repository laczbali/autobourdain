{
  "name": "autobourdain",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @autobourdain/mobile",
    "dev:api": "wrangler dev",
    "build": "npm run build -w @autobourdain/mobile",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "cf-typegen": "wrangler types",
    "db:generate": "npm run db:generate -w @autobourdain/api",
    "db:migrate": "wrangler d1 migrations apply autobourdain --local",
    "db:migrate:remote": "wrangler d1 migrations apply autobourdain --remote",
    "db:studio": "npm run db:studio -w @autobourdain/api"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=22"
  }
}
