{
  "name": "autobourdain",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @autobourdain/mobile",
    "dev:api": "wrangler dev",
    "build": "npm run build -w @autobourdain/mobile",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf-typegen": "wrangler types",
    "db:generate": "npm run db:generate -w @autobourdain/api",
    "db:migrate": "wrangler d1 migrations apply autobourdain --local",
    "db:migrate:remote": "wrangler d1 migrations apply autobourdain --remote",
    "db:studio": "npm run db:studio -w @autobourdain/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=22"
  }
}
