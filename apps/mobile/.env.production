# Loaded by `expo export` (NODE_ENV=production), which is what `npm run build`
# runs on Cloudflare. EXPO_PUBLIC_API_URL is deliberately unset here - in
# production the app and the API share an origin.

# Turnstile site key from the Cloudflare dashboard (Turnstile -> the
# autobourdain widget). Public, and committed on purpose: it has to be in the
# bundle at build time. The secret key is a Worker secret, set in the dashboard.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEy5fMfT6fXQ_yVs
