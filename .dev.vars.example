# Copy to .dev.vars for local `wrangler dev`. Never commit .dev.vars.
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="dev-only-change-me"

# Cloudflare Turnstile. This is the public always-passes test secret, which is
# all local development needs - production uses a real one from the dashboard.
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Encrypts users' AI provider keys at rest. Any 32 random bytes in base64 -
# generate one with the command above. Changing it makes stored keys unreadable,
# so locally that just means pasting your key in again.
AI_KEY_ENCRYPTION_KEY=""

# Comma-separated emails made admin on sign-up, or on their next sign-in. Only
# a verified email counts, which means a GitHub sign-in - see the README.
ADMIN_EMAILS=""

# The matching always-passes test site key, for the /api/turnstile page the
# native app loads in a WebView. Overrides wrangler.jsonc locally: the real
# widget only accepts autobourdain.blaczko.com, not localhost or a LAN IP.
TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# GitHub OAuth app (https://github.com/settings/developers). One app carries
# both callback URLs - http://localhost:8787/api/auth/callback/github for here
# and the deployed origin's for production. The client id is public and lives
# in wrangler.jsonc, which `wrangler dev` reads too - only the secret is needed
# here. Setting the id here as well would just override the file with a blank.
GITHUB_CLIENT_SECRET=""

# wrangler.jsonc points BETTER_AUTH_URL at the deployed origin, and `wrangler
# dev` reads that file too. Blank it here so local auth falls back to the
# incoming request origin instead of redirecting to production.
BETTER_AUTH_URL=""
